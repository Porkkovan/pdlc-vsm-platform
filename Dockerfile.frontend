FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build && \
    sed -i 's/ crossorigin//g' dist/index.html && \
    sed -i 's|<script type="module" src="\([^"]*\)"></script>|<script type="module">import("\1");<\/script>|' dist/index.html

# Production: nginx serves static + proxies /api to backend
FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/debug.html /usr/share/nginx/html/debug.html
COPY nginx.conf.template /etc/nginx/nginx.conf.template
COPY docker-entrypoint-frontend.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENV BACKEND_URL=https://stump-api.azurewebsites.net

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
